---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { getContent } from '../i18n';
import portrait from '../assets/portrait.jpg';

const { hero } = getContent(Astro.currentLocale);

---
<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__cta">
        <a class="btn" href="#contact">{hero.primary}</a>
        <a class="btn btn--ghost" href="#work">{hero.secondary}</a>
      </div>
    </div>
    <aside class="card" aria-label={hero.card.label}>
      <div class="card__id">
        <Image class="card__photo" src={portrait} alt={site.person} width={72} height={72} densities={[1, 2, 4]} loading="eager" />
        <div>
          <p class="card__name">{site.person}</p>
          <p class="card__role">{hero.card.role}</p>
        </div>
      </div>
      <dl class="card__list">
        {hero.card.rows.map((r) => (
          <div>
            <dt>{r.term}</dt>
            {/* A list value (e.g. fields) gets one item per line. */}
            <dd>{Array.isArray(r.value) ? <ul class="card__tags">{r.value.map((v) => <li>{v}</li>)}</ul> : r.value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
  <div class="container">
    <ul class="facts">
      {hero.facts.map((f) => (
        <li><span class="facts__value">{f.value}</span><span class="facts__label">{f.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 4.5rem); }
  .hero__grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 60rem) { .hero__grid { grid-template-columns: 1fr 23.5rem; gap: 4rem; } }
  .hero__lead { margin-top: 1.5rem; max-width: 38rem; color: var(--ink-2); font-size: clamp(1.0625rem, 1.6vw, 1.25rem); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }

  .card { border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: var(--radius); padding: 1.75rem; background: var(--bg); }
  .card__id { display: flex; align-items: center; gap: 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
  .card__photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none; }
  .card__name { font-weight: 600; font-size: 1.125rem; }
  .card__role { color: var(--muted); font-size: 0.9375rem; }
  .card__list { margin: 1.25rem 0 0; display: grid; gap: 0.875rem; }
  .card__list div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.75rem; font-size: 0.9375rem; }
  .card__list dt { color: var(--muted); }
  .card__list dd { margin: 0; }
  .card__tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .card__tags li { padding: 0.0625rem 0.5rem; border: 1px solid var(--line); border-radius: 999px; font-size: 0.8125rem; line-height: 1.6; }

  .facts { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); margin-top: clamp(3rem, 6vw, 4.5rem); border-top: 1px solid var(--line); }
  /* Two columns: an odd last fact takes the full row. */
  .facts li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 40rem) {
    .facts { grid-template-columns: repeat(3, 1fr); }
    .facts li:last-child:nth-child(odd) { grid-column: auto; }
  }
  @media (min-width: 60rem) { .facts { grid-template-columns: repeat(5, 1fr); } }
  .facts li { display: flex; flex-direction: column; gap: 0.25rem; padding: 1.5rem 1rem 0 0; }
  .facts__value { font-family: var(--font-head); font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 600; line-height: 1; color: var(--ink); }
  .facts__label { color: var(--ink-2); font-size: 0.9375rem; }
</style>
