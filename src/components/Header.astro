---
import { site } from '../data/site';
import { getContent } from '../i18n';
import { otherLocale, routes, toLocale, type PageKey } from '../i18n/config';
import MobileNav from './MobileNav';

interface Props {
  page: PageKey;
}
const { page } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = getContent(locale);
const other = otherLocale(locale);

// On the home page anchors stay local; elsewhere they point back to the home page.
const base = page === 'home' ? '' : routes.home[locale];
const links = t.nav.map((n) => ({ href: `${base}#${n.id}`, label: n.label }));
const contact = links[links.length - 1];
---
<header class="header">
  <div class="container header__inner">
    <a class="brand" href={routes.home[locale]} aria-label={`${site.name}, ${t.ui.home}`}>
      <img src="/logo.png" alt="" width="40" height="35" />
      <span>{site.name}</span>
    </a>
    <div class="header__right">
      <nav class="nav" aria-label={t.ui.navLabel}>
        <ul>
          {links.slice(0, -1).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <a class="lang" href={routes[page][other]} hreflang={other} lang={other} aria-label={t.ui.switchLabel}>
        {other.toUpperCase()}
      </a>
      <a class="btn header__cta" href={contact.href}>{t.ui.contactCta}</a>
      <MobileNav
        client:media="(max-width: 59.99rem)"
        links={links}
        labels={{ nav: t.ui.navLabel, open: t.ui.menuOpen, close: t.ui.menuClose }}
      />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: 0.01em;
  }
  .brand img { width: 40px; height: auto; }
  .header__right { display: flex; align-items: center; gap: 0.75rem; }
  .nav { display: none; margin-right: 1rem; }
  .nav ul { display: flex; gap: 1.75rem; list-style: none; }
  .nav ul a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9688rem;
    font-weight: 500;
  }
  .nav ul a:hover { color: var(--brand-ink); }
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.5rem;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .lang:hover { border-color: var(--ink); color: var(--ink); }
  .header__cta { display: none; min-height: 2.5rem; padding-block: 0.375rem; font-size: 0.9375rem; }
  @media (min-width: 60rem) {
    .nav, .header__cta { display: flex; }
  }
</style>
